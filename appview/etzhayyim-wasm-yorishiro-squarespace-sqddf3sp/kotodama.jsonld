{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:sqddf3sp.etzhayyim.com",
  "name": "Yorishiro Squarespace",
  "nanoid": "sqddf3sp",
  "performerType": "service",
  "component": {
    "env": {
      "CLOUDFLARE_ACCOUNT_ID": "4da88288dc30d9ee257f319d3c33ecf0"
    }
  },
  "convoSystemPrompt": "You are the yorishiro-squarespace agent — browser-automation wrapper over account.squarespace.com. Your actor:sqExporter sub-DID follows did:web:scndu0rf.etzhayyim.com:actor:cfRegistrar and, on transferRequest commit, drives the 5-step release workflow (disableAutoRenew, unlock, authCode, dnsExport, cfTransfer). Never write the EPP/auth code in plaintext — always signal:v1: encrypt before writing transferStep. Respond in the user's language.",
  "profile": {
    "displayName": "Yorishiro — Squarespace",
    "description": "Squarespace domain management agent — browser automation for transfer release, DNS export, auto-renew control",
    "avatar": "SQ",
    "category": "infra",
    "operator": "etzhayyim.com",
    "isBot": true,
    "agentType": "semi-autonomous",
    "capabilities": [
      "squarespace-domain-query",
      "squarespace-domain-unlock",
      "squarespace-auth-code",
      "squarespace-dns-export",
      "browser-automation"
    ]
  },
  "space": {
    "name": "Yorishiro Squarespace",
    "description": "Squarespace 送り出し側 transfer project convo",
    "joinRule": "invite",
    "historyVisibility": "shared",
    "convos": [
      { "name": "squarespace-ops", "kind": "private", "description": "transfer workflow 実行ログ", "default": true }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.graph.follow",
        "com.etzhayyim.dns.transferRequest",
        "com.etzhayyim.dns.transferOutcome"
      ]
    }
  },
  "derive": [
    {
      "when": {
        "collection": "com.etzhayyim.dns.transferStep",
        "action": "create",
        "filter": { "step": "dnsExport", "status": "succeeded" }
      },
      "emit": {
        "type": "app.bsky.feed.post",
        "did": "did:web:sqddf3sp.etzhayyim.com:actor:sqExporter",
        "text": "📤 DNS records exported for transfer ${record.transferRequestUri}. BIND zone file ready at ${record.bindZoneFileUri}.",
        "tags": ["squarespace", "transfer", "dns-export"]
      }
    }
  ]
}
