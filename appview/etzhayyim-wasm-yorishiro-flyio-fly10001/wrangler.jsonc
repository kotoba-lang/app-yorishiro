{
  "name": "kotodama-fly10001",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_ACTOR_HANDLE": "yorishiro-flyio",
    "APP_CAPABILITIES": "[\"flyio-account-query\",\"flyio-app-delete\",\"flyio-org-delete\",\"flyio-account-close\",\"browser-automation\"]",
    "APP_DESCRIPTION": "Fly.io アカウント管理・解約自動化エージェント — app 削除 / org 削除 / アカウント閉鎖を browser automation で実行",
    "APP_DISPLAY_NAME": "Yorishiro — Fly.io 解約",
    "APP_EMBED_URL": "https://fly10001.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "fly10001",
    "APP_PERFORMER_TYPE": "",
    "APP_UI_TYPE": "appview",
    "MURAKUMO_URL": "https://murakumo.etzhayyim.com/api/openai/v1/chat/completions",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "fly10001.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
