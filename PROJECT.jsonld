{
  "@context": "https://schema.org",
  "@type": "Project",
  "name": "Yorishiro — Web Service Browser Automation",
  "identifier": "etzhayyim-project-yorishiro",
  "description": "Apify-inspired web service abstraction layer. A native Go provider (Playwright/Chromium) exports browser automation primitives; per-service TinyGo wasm components encode service-specific navigation logic and export typed gRPC/MCP interfaces. Yorishiro (依り代) channels external web services into the etzhayyim.com wRPC mesh.",
  "hasPart": [
    {
      "@type": "SoftwareApplication",
      "name": "Yorishiro Provider",
      "description": "Native Go provider with Playwright Chromium browser pool. Exports etzhayyim:yorishiro/browser, session-store, auth via wRPC.",
      "applicationCategory": "capability-provider",
      "runtimePlatform": "native-go"
    },
    {
      "@type": "SoftwareApplication",
      "name": "Yorishiro Google Adapter",
      "identifier": "etzhayyim-wasm-yorishiro-google-g00gl3ws",
      "description": "Google web service adapter — Search, Gmail, Drive, Calendar.",
      "applicationCategory": "wasm-component",
      "runtimePlatform": "tinygo-wasm"
    },
    {
